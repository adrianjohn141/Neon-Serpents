# Generated safely by ops/bootstrap-local.ps1. Never commit .env.docker.
POSTGRES_PASSWORD=replace-me
MINIO_ROOT_USER=neon-local
MINIO_ROOT_PASSWORD=replace-me-with-at-least-16-characters
ADMIN_PASSWORD_HASH_B64=replace-me
SESSION_SECRET=replace-me
MANIFEST_SIGNING_SEED=replace-me-base64-32-bytes
ACTOR_COUNT=12
COOKIE_SECURE=false
# Keep disabled in normal operation. This only permits a full-coverage local
# testing promotion that did not satisfy the normal benchmark gates.
ALLOW_MANUAL_PROMOTION=false
LOCAL_BACKUP_PATH=./artifacts/backups
RESTIC_PASSWORD=replace-me
RESTIC_REPOSITORY=/repository
